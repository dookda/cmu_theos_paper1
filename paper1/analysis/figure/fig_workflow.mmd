flowchart TB
    subgraph S1["<b>1 &nbsp;Data</b>"]
        direction LR
        IMG["<b>THEOS-2 imagery</b><br/>two scenes, 0.5 m, R G B NIR<br/>8 January 2026"]
        REF["<b>Reference masks</b><br/>drawn on the same imagery<br/>7 classes (grass merged into background)"]
        TILE["<b>Tiling</b><br/>512 px tiles, 448 px stride<br/>64 px overlap per side"]
    end
    subgraph S2["<b>2 &nbsp;Spatial partition</b>"]
        direction LR
        SPLIT["<b>Spatial split</b><br/>1500 m blocks, one-tile buffer (365 tiles dropped)<br/>Scene 2 held out as the external set"]
        COUNT["<b>Split sizes</b><br/>train 1286 · validation 304 · test 399 · external 287<br/>evaluation tiles touching training: 0"]
    end
    subgraph S3["<b>3 &nbsp;Factorial experiment</b>"]
        direction LR
        FACT["<b>8 conditions × 9 architectures × 5 seeds = 360 runs</b><br/>input bands (RGB, RGB + NIR) × augmentation (off, on) × class weighting (off, on)<br/>each effect estimated once per seed in every architecture"]
    end
    subgraph S4["<b>4 &nbsp;Selection and held-out reads</b>"]
        direction LR
        SEL["<b>Ensemble selection</b><br/>on the validation split only<br/>greedy forward selection"]
        LOCK["<b>Held-out sets locked</b><br/>test read once, external read once<br/>after every choice is frozen"]
    end
    subgraph S5["<b>5 &nbsp;Analysis</b>"]
        direction LR
        EFF["<b>Factor effects</b><br/>95% intervals over matched seeds"]
        UNC["<b>Spatial uncertainty</b><br/>paired bootstrap over spatial blocks<br/>per-class IoU, confusion, full-scene map"]
        SCORE["<b>Two scoring definitions</b><br/>seven-class mIoU, background scored (primary)<br/>six-class mIoU: original predictions; background not predicted"]
    end
    subgraph S6["<b>6 &nbsp;Reference audit</b>"]
        direction LR
        AUDIT["<b>Audit of the reference labels</b><br/>blinded point sample read by two reviewers (kappa 0.76)<br/>parcel adjudication against the 2020 national land-use layer"]
    end
    subgraph S7["<b>7 &nbsp;Sensitivity of reported accuracy (pre-registered)</b>"]
        direction LR
        A1["<b>Random-split<br/>control</b>"]
        A2["<b>Transfer to a<br/>second province</b><br/>raw and moment matched;<br/>calibration"]
        A3["<b>Background as<br/>a target</b><br/>removed at inference<br/>or in training;<br/>six-class ensemble score"]
        A4["<b>Tile-border<br/>analysis</b>"]
        A5["<b>Variance by<br/>seed and factor</b>"]
    end
    subgraph S8["<b>8 &nbsp;Reporting</b>"]
        direction LR
        R1["<b>Effect sizes on one axis</b><br/>training, evaluation regime, reference definition (figure 8)"]
        R2["<b>Reporting checklist</b><br/>what to state with an accuracy figure (table 4)"]
    end
    IMG --> REF --> TILE
    SPLIT --> COUNT
    SEL --> LOCK
    S1 --> S2 --> S3 --> S4 --> S5 --> S6 --> S7 --> S8
